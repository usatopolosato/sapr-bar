QWidget {
    color: ${text};
    font-family: "Segoe UI";
    font-size: 13px;
}
QMainWindow, #centralWidget, QStackedWidget, QWidget[role="page"] {
    background: ${window};
}
QLabel {
    background: transparent;
    border: none;
}
#topBar {
    background: ${surface};
    border-bottom: 1px solid ${border};
}
#brandLabel {
    color: ${text};
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 1px;
}
#brandMark {
    color: ${accent};
    font-size: 32px;
}
#brandDivider { color: ${muted}; }
#sidebar {
    background: ${surface};
    border-right: 1px solid ${border};
}
QLabel[role="eyebrow"] {
    color: ${muted};
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.8px;
}
QLabel[role="heroTitle"] {
    color: ${text};
    font-size: 38px;
    font-weight: 600;
}
QLabel[role="pageTitle"] {
    color: ${text};
    font-size: 28px;
    font-weight: 600;
}
QLabel[role="cardTitle"] {
    color: ${text};
    font-size: 17px;
    font-weight: 600;
}
QLabel[role="muted"] {
    color: ${muted};
    font-size: 12px;
}
QLabel[role="author"] {
    color: ${muted};
    font-size: 11px;
    padding-top: 14px;
}
QLabel[role="largeNumber"] {
    color: ${accent};
    font-size: 48px;
    font-weight: 300;
}
QLabel[role="badge"] {
    color: ${selection_text};
    background: ${selection};
    border: 1px solid ${selection};
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
}
QFrame[role="card"], QFrame[role="inspector"], #canvasCard, #dataCard, #inspectorCard {
    background: ${panel};
    border: 1px solid ${border};
    border-radius: 8px;
}
QFrame[role="card"] QLabel, QFrame[role="inspector"] QLabel {
    border: none;
}
QLabel[role="badge"]:disabled {
    color: ${muted};
    background: ${surface};
}
QFrame[frameShape="4"] {
    color: ${border};
    background: ${border};
    border: none;
    max-height: 1px;
}
QPushButton {
    border: 1px solid ${border};
    background: ${surface};
    border-radius: 5px;
    padding: 10px 15px;
    min-height: 20px;
    color: ${text};
    font-weight: 500;
}
QPushButton:hover {
    background: ${hover};
    border-color: ${border};
}
QPushButton:pressed {
    background: ${pressed};
}
QPushButton:focus {
    border: 1px solid ${accent};
}
QPushButton:disabled {
    color: ${disabled};
    background: ${surface};
    border-color: ${border};
}
QPushButton[role="primary"] {
    background: ${accent};
    color: ${accent_text};
    border: 1px solid ${accent};
    font-weight: 600;
}
QPushButton[role="primary"]:hover {
    background: ${accent_hover};
    border-color: ${accent_hover};
}
QPushButton[role="primary"]:pressed { background: ${accent_pressed}; }
QPushButton[role="primary"]:focus { border: 1px solid ${text}; }
QPushButton[role="secondary"] { background: transparent; }
QPushButton[role="secondary"]:hover { background: ${hover}; }
QPushButton[role="tool"] {
    padding: 6px 11px;
    min-height: 18px;
    background: transparent;
    border-color: ${border};
    font-size: 12px;
}
QPushButton[role="tool"]:checked {
    background: ${selection};
    color: ${selection_text};
    border-color: ${accent};
}
QPushButton[role="nav"] {
    text-align: left;
    background: transparent;
    border: 1px solid transparent;
    padding: 12px 10px;
    color: ${muted};
    font-size: 12px;
}
QPushButton[role="nav"]:hover { background: ${hover}; color: ${text}; }
QPushButton[role="nav"]:checked {
    background: ${selection};
    border-color: ${selection};
    color: ${selection_text};
}
QPushButton[role="nav"]:focus { border-color: ${accent}; }
QGraphicsView {
    background: ${canvas};
    border: none;
}
QSplitter::handle { background: transparent; }
QSplitter::handle:hover { background: ${accent}; }
QTabWidget::pane { border: none; background: transparent; }
#inspectorTabs QStackedWidget { background: transparent; }
QTabBar::tab {
    color: ${muted};
    background: transparent;
    border-bottom: 2px solid transparent;
    padding: 9px 16px;
    margin-bottom: 6px;
}
QTabBar::tab:selected { color: ${selection_text}; border-bottom-color: ${accent}; }
QTabBar::tab:hover { color: ${text}; }
QTableWidget, QTableView {
    border: none;
    background: ${panel};
    alternate-background-color: ${alternate};
    gridline-color: ${border};
    selection-background-color: ${selection};
    selection-color: ${selection_text};
    outline: none;
}
QTableView::item { padding: 9px; border-bottom: 1px solid ${border}; }
QTableView::item:selected { background: ${selection}; color: ${selection_text}; }
QHeaderView::section {
    background: ${surface};
    color: ${muted};
    border: none;
    border-bottom: 1px solid ${border};
    padding: 9px;
    font-size: 11px;
    font-weight: 600;
}
QTableCornerButton::section { background: ${surface}; border: none; }
QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox {
    background: ${input_background};
    border: 1px solid ${border};
    border-radius: 6px;
    padding: 8px 10px;
    min-height: 20px;
    selection-background-color: ${selection};
    color: ${text};
}
QLineEdit:focus, QDoubleSpinBox:focus { border-color: ${accent}; }
QComboBox:hover, QComboBox:focus { border-color: ${accent}; }
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { width: 0; border: none; }
QScrollBar:vertical { background: transparent; width: 7px; margin: 0; }
QScrollBar::handle:vertical { background: ${scrollbar}; min-height: 30px; border-radius: 3px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
QScrollBar:horizontal { background: transparent; height: 7px; margin: 0; }
QScrollBar::handle:horizontal { background: ${scrollbar}; min-width: 30px; border-radius: 3px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }
QToolTip { background: ${panel}; color: ${text}; border: 1px solid ${border}; padding: 6px; }
QMessageBox, QInputDialog, QFileDialog { background: ${panel}; }
QDialog { background: ${panel}; }
QListWidget {
    background: ${input_background};
    border: 1px solid ${border};
    border-radius: 6px;
    padding: 6px;
    outline: none;
}
QListWidget::item { padding: 12px; border-radius: 4px; }
QListWidget::item:selected { color: ${selection_text}; background: ${selection}; }
QComboBox { padding: 5px 10px; min-height: 18px; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView { background: ${surface}; selection-background-color: ${selection}; border: 1px solid ${border}; }

QToolButton#themeButton, QToolButton#sectionButton {
    background: transparent;
    border: 1px solid ${border};
    border-radius: 5px;
    color: ${muted};
    padding: 7px 13px;
}
QToolButton#themeButton:hover, QToolButton#themeButton:pressed, QToolButton#sectionButton:hover, QToolButton#sectionButton:pressed {
    background: ${hover};
    color: ${text};
}
QToolButton#themeButton:focus, QToolButton#sectionButton:focus { border-color: ${accent}; }
QToolButton#themeButton::menu-indicator, QToolButton#sectionButton::menu-indicator { image: none; width: 0; }
QScrollArea { border: none; background: ${window}; }
QMenu {
    background: ${panel};
    border: 1px solid ${border};
    padding: 5px;
}
QMenu::item {
    background: transparent;
    color: ${text};
    border-radius: 4px;
    padding: 8px 18px;
}
QMenu::item:selected { background: ${selection}; color: ${selection_text}; }
QMenu::item:checked { color: ${accent}; font-weight: 600; }
QMenu::item:disabled { color: ${disabled}; }
QMenu::indicator { width: 0; }
QWidget:disabled { color: ${disabled}; }
QLabel[role="formula"] {
    font-family: "Consolas";
    font-size: 24px;
    font-weight: 500;
}
#solutionCard QStackedWidget, #matrixPage, #equationsPage, #displacementsPage, #LinearSystemView {
    background: ${panel};
}
#ProcessorPage QTableView {
    font-family: "Consolas";
    font-size: 13px;
}
#ProcessorPage QTableView::item {
    padding: 6px;
}
#backSubstitutionPanel, #backSubstitutionDetails, #forwardControls, #forwardDetails {
    background: ${panel};
    border: none;
}
#backSubstitutionDetails, #forwardDetails {
    color: ${text};
    font-family: "Consolas";
    font-size: 15px;
    selection-background-color: ${selection};
    selection-color: ${selection_text};
}
QLabel[role="error"], QFrame[role="card"] QLabel[role="error"], QFrame[role="inspector"] QLabel[role="error"] {
    color: ${error_text};
    background: ${error_background};
    border: 1px solid ${error_border};
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
}
QLineEdit[invalid="true"], QLineEdit[invalid="true"]:focus {
    color: ${error_text};
    background: ${error_background};
    border-color: ${error_border};
}
#plotsCard QStackedWidget, #epuresPage, #graphPage, #tablePage {
    background: ${panel};
}
#formulasView {
    background: ${panel};
    color: ${text};
    border: none;
    font-family: "Segoe UI";
    font-size: 12px;
}
